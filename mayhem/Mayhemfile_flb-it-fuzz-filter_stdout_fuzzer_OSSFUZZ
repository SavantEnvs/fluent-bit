# Upstream libFuzzer harness tests/internal/fuzzers/filter_stdout_fuzzer.c, built the way OSS-Fuzz builds it
# (CMake target flb-it-fuzz-filter_stdout_fuzzer_OSSFUZZ); see mayhem/build.sh.
# Each input creates, starts, stops and destroys a whole fluent-bit engine and sleeps for the flush
# (upstream's design): one exec takes about 4 s as a fresh process whatever the input size or CPU
# share, so the per-exec timeout is set well above that. The small seeds give Mayhem's start-up
# sanity check inputs that are known to run cleanly.
project: savantenvs/fluent-bit
target: flb-it-fuzz-filter_stdout_fuzzer_OSSFUZZ

cmds:
  - cmd: /mayhem/flb-it-fuzz-filter_stdout_fuzzer_OSSFUZZ
    libfuzzer: true
    timeout: 30

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/flb-it-fuzz-filter_stdout_fuzzer_OSSFUZZ/testsuite

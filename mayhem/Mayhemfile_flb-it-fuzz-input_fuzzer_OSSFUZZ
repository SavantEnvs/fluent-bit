# Upstream libFuzzer harness tests/internal/fuzzers/input_fuzzer.c, built the way OSS-Fuzz builds it
# (CMake target flb-it-fuzz-input_fuzzer_OSSFUZZ); see mayhem/build.sh.
# The harness returns before touching fluent-bit unless the input is >= 60 bytes (a 30-byte record,
# then a 10-byte property key and a 10-byte value), so a cold corpus of short inputs covers
# nothing; the seeds below are valid 64-byte inputs. Each accepted input starts and stops a whole
# engine and sleeps twice (upstream's design, ~5 s per exec), hence the generous per-exec timeout.
project: savantenvs/fluent-bit
target: flb-it-fuzz-input_fuzzer_OSSFUZZ

cmds:
  - cmd: /mayhem/flb-it-fuzz-input_fuzzer_OSSFUZZ
    libfuzzer: true
    timeout: 30

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/flb-it-fuzz-input_fuzzer_OSSFUZZ/testsuite
